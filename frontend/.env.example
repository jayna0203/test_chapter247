# API Configuration
NEXT_PUBLIC_API_URL=https://dummyjson.com

# Auto-logout Configuration (in milliseconds)
# Default: 10 minutes = 600000ms
NEXT_PUBLIC_INACTIVITY_TIMEOUT=600000

# Warning time before logout (in milliseconds)  
# Default: 60 seconds = 60000ms
NEXT_PUBLIC_WARNING_TIME=60000

# Note: This app uses DummyJSON API which doesn't require authentication
# In a production app, you would add:
# - API keys
# - Backend URL
# - Database connection strings
# - Other sensitive configuration

